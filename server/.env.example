# Copy this file to .env and fill in real values before deploying.

# Secret used to sign login JWTs. MUST be changed to a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Port the server listens on. Most hosts (Render, Railway, Fly) set this for you.
PORT=4000

# Where the SQLite database file is stored. On Render/Railway, point this at your
# mounted persistent disk, e.g. /data/316-pckle.db — otherwise data is lost on redeploy.
DB_PATH=./data/316-pckle.db

# Comma-separated list of origins allowed to call this API (your deployed frontend URL).
# Leave blank in development to allow all origins.
CORS_ORIGIN=
